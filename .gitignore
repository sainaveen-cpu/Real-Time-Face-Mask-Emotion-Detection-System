"""Streamlit app: emotion detection from webcam snapshots or uploaded images.

Run:  streamlit run app.py
"""
import json

import cv2
import numpy as np
import pandas as pd
import streamlit as st
from PIL import Image
from tensorflow.keras.models import load_model

st.set_page_config(page_title="Emotion Detection", page_icon="😊")
st.title("😊 Emotion Detection System")


@st.cache_resource
def load_assets():
    model = load_model("model/emotion_model.h5")
    with open("model/labels.json") as f:
        labels = json.load(f)
    cascade = cv2.CascadeClassifier(
        cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
    )
    return model, labels, cascade


model, labels, face_cascade = load_assets()

if "history" not in st.session_state:
    st.session_state.history = []


def detect_emotions(rgb_image):
    """Return the annotated image and a list of (emotion, confidence)."""
    gray = cv2.cvtColor(rgb_image, cv2.COLOR_RGB2GRAY)
    faces = face_cascade.detectMultiScale(gray, scaleFactor=1.3, minNeighbors=5)
    results = []
    for (x, y, w, h) in faces:
        face = cv2.resize(gray[y:y + h, x:x + w], (48, 48))
        face = face.reshape(1, 48, 48, 1).astype("float32")
        probs = model.predict(face, verbose=0)[0]
        idx = int(np.argmax(probs))
        emotion, conf = labels[idx], float(probs[idx])
        results.append((emotion, conf))
        cv2.rectangle(rgb_image, (x, y), (x + w, y + h), (0, 255, 0), 2)
        cv2.putText(rgb_image, f"{emotion} {conf:.0%}", (x, max(y - 10, 20)),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2)
    return rgb_image, results


def process(pil_image):
    rgb = np.array(pil_image.convert("RGB"))
    annotated, results = detect_emotions(rgb)
    st.image(annotated, use_container_width=True)
    if not results:
        st.warning("No face detected. Try a clearer, front-facing photo.")
    for emotion, conf in results:
        st.success(f"{emotion.capitalize()} ({conf:.0%} confidence)")
        st.session_state.history.append(emotion)


tab_cam, tab_upload = st.tabs(["📷 Webcam", "🖼️ Upload image"])

with tab_cam:
    shot = st.camera_input("Take a photo")
    if shot:
        process(Image.open(shot))

with tab_upload:
    file = st.file_uploader("Choose an image", type=["jpg", "jpeg", "png"])
    if file:
        process(Image.open(file))

st.divider()
st.subheader("Emotion history (this session)")
if st.session_state.history:
    counts = pd.Series(st.session_state.history).value_counts()
    st.bar_chart(counts)
    if st.button("Clear history"):
        st.session_state.history = []
        st.rerun()
else:
    st.caption("No detections yet.")
